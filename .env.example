# -----------------------------------------------------------------------------
# PathNER - Production Environment Configuration Template
# -----------------------------------------------------------------------------

# Flask Application Settings
FLASK_APP=app.py
FLASK_DEBUG=False
PORT=5000
SECRET_KEY=generate_a_secure_random_string_for_production

# Data & Database Paths
DATA_DIR=data
DATABASE_PATH=data/database.sqlite

# Risk Model Parameters & Thresholds
RISK_BLOCKED_THRESHOLD=70.0
RISK_HIGH_THRESHOLD=50.0
RISK_MODERATE_THRESHOLD=25.0

# Mistral AI Cloud API for intelligent logistics reasoning & multilingual briefings
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# OpenWeatherMap API for live district weather feeds (optional)
OPENWEATHER_API_KEY=

# Mapbox / Private Tile Server Access Token (optional)
MAPBOX_ACCESS_TOKEN=

# SMS / Alert Notification Gateway Key (optional)
SMS_GATEWAY_API_KEY=
