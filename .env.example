# -----------------------------------------------------------------------------
# PathNER - Sample Environment Template (.env.example)
# Copy this file to .env and adjust the values as needed
# -----------------------------------------------------------------------------

# Flask Application Settings
FLASK_APP=app.py
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=your-secure-random-secret-key-here

# Database & Data Paths
DATA_DIR=data
DATABASE_PATH=data/database.sqlite

# Risk Model Parameters & Thresholds
RISK_BLOCKED_THRESHOLD=70.0
RISK_HIGH_THRESHOLD=50.0
RISK_MODERATE_THRESHOLD=25.0

# External API Integrations (Optional)
OPENWEATHER_API_KEY=your_openweather_api_key_here
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
SMS_GATEWAY_API_KEY=your_sms_gateway_key_here
